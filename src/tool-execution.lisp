(in-package :agento11y-cl)

(defun tool-execution-kind-p (kind)
  (and (member kind '(:load-skill :read-skill-resource :command) :test #'eq) t))

(defun tool-whitespace-p (character)
  (let ((code (char-code character)))
    (or (<= #x09 code #x0d)
        (member code '(#x20 #x85 #xa0 #x1680 #x2028 #x2029 #x202f #x205f #x3000))
        (<= #x2000 code #x200a))))

(defun normalize-tool-string (value)
  (when (stringp value)
    (let ((start (position-if-not #'tool-whitespace-p value))
          (end (position-if-not #'tool-whitespace-p value :from-end t)))
      (when start
        (subseq value start (1+ end))))))

(defun tool-execution-span-name (kind tool-name skill-name resource-name executable-name)
  (unless (tool-execution-kind-p kind)
    (return-from tool-execution-span-name
      (format nil "execute_tool ~a" (or tool-name "unknown"))))
  (let* ((tool (or (normalize-tool-string tool-name) "unknown"))
         (skill (normalize-tool-string skill-name))
         (resource (normalize-tool-string resource-name))
         (executable (normalize-tool-string executable-name))
         (suffix (case kind
                   (:load-skill (list skill))
                   ((:read-skill-resource :command)
                    (cond (resource (list skill resource))
                          ((eq kind :command) (list executable)))))))
    (format nil "~{~a~^ ~}"
            (append (list "execute_tool" tool) (remove nil suffix)))))

(defun tool-uri-input-valid-p (value)
  ;; Discarded credentials, queries and fragments must not hide malformed input.
  (loop for index from 0 below (length value)
        for character = (char value index)
        for code = (char-code character)
        always (and (not (or (char= character #\\)
                             (tool-whitespace-p character)
                             (< code #x20)
                             (<= #x7f code #x9f)))
                    (or (char/= character #\%)
                        (and (< (+ index 2) (length value))
                             (digit-char-p (char value (1+ index)) 16)
                             (digit-char-p (char value (+ index 2)) 16)
                             (progn (incf index 2) t))))))

(defun tool-uri-port-p (value)
  (and (plusp (length value))
       (every (lambda (character) (char<= #\0 character #\9)) value)
       (<= (parse-integer value) 65535)))

(defun tool-uri-ipv4-p (value)
  (let ((parts (cl-ppcre:split "\\." value :limit most-positive-fixnum)))
    (and (= (length parts) 4)
         (every (lambda (part)
                  (and (<= 1 (length part) 3)
                       (tool-uri-port-p part)
                       (<= (parse-integer part) 255)))
                parts))))

(defun tool-uri-decoded-host-valid-p (value)
  (handler-case
      (let* ((octets (loop for index from 0 below (length value)
                           for character = (char value index)
                           nconc (if (char= character #\%)
                                     (prog1 (list (parse-integer value :start (1+ index)
                                                                      :end (+ index 3)
                                                                      :radix 16))
                                       (incf index 2))
                                     (coerce (string-to-utf8-octets (string character)) 'list))))
             ;; Percent escapes encode UTF-8 bytes, not individual Unicode characters.
             (decoded (babel:octets-to-string (coerce octets '(vector (unsigned-byte 8)))
                                              :encoding :utf-8 :errorp t)))
        ;; Encoded delimiters cannot turn a host into another URI component.
        (notany (lambda (character)
                  (let ((code (char-code character)))
                    (or (find character "/\\?#@[]:")
                        (tool-whitespace-p character)
                        (< code #x20)
                        (<= #x7f code #x9f))))
                decoded))
    (error () nil)))

(defun tool-uri-ipv6-p (value)
  (let* ((zone (search "%25" value))
         (address (if zone (subseq value 0 zone) value))
         (compression (search "::" address))
         (parts (remove "" (cl-ppcre:split ":" address) :test #'string=))
         (width 0))
    (and (plusp (length address))
         (or (not zone)
             (and (< (+ zone 3) (length value))
                  (cl-ppcre:scan "\\A(?:[A-Za-z0-9._~-]|%[0-9A-Fa-f]{2})+\\z"
                                 (subseq value (+ zone 3)))
                  (tool-uri-decoded-host-valid-p (subseq value (+ zone 3)))))
         (not (and compression (search "::" address :start2 (1+ compression))))
         (or (char/= (char address 0) #\:) (eql compression 0))
         (or (char/= (char address (1- (length address))) #\:)
             (and compression (= compression (- (length address) 2))))
         (loop for tail on parts
               for part = (car tail)
               always (cond
                        ((find #\. part)
                         (incf width 2)
                         (and (null (cdr tail))
                              (tool-uri-ipv4-p part)
                              (or (not compression)
                                  (< compression (- (length address) (length part))))))
                        (t
                         (incf width)
                         (and (<= 1 (length part) 4)
                              (every (lambda (character) (digit-char-p character 16)) part)))))
         (if compression (< width 8) (= width 8)))))

(defun tool-uri-host-p (host)
  (and (plusp (length host))
       (tool-uri-decoded-host-valid-p host)
       (loop for index from 0 below (length host)
             for character = (char host index)
             always
             (if (char= character #\%)
                 (progn (incf index 2) t)
                 (or (alphanumericp character)
                     (find character "-._~!$&'()*+,;=")
                     (>= (char-code character) #xa0))))))

(defun tool-uri-authority-p (authority file-p)
  (when (> (count #\@ authority) 1)
    (return-from tool-uri-authority-p nil))
  (let* ((at (position #\@ authority))
         (host-port (subseq authority (if at (1+ at) 0))))
    (when (and at
               (not (cl-ppcre:scan "\\A(?:[A-Za-z0-9._~!$&'()*+,;=:%-]|[^\\x00-\\x9f])*\\z"
                                  (subseq authority 0 at))))
      (return-from tool-uri-authority-p nil))
    (cond
      ((zerop (length host-port))
       (and file-p (not at)))
      ((char= (char host-port 0) #\[)
       (let ((close (position #\] host-port)))
         (and close
              (let ((literal (subseq host-port 1 close)))
                (or (tool-uri-ipv6-p literal)
                    (cl-ppcre:scan "\\A[vV][0-9A-Fa-f]+\\.[A-Za-z0-9._~!$&'()*+,;=:-]+\\z"
                                   literal)))
              (or (= (1+ close) (length host-port))
                  (and (char= (char host-port (1+ close)) #\:)
                       (tool-uri-port-p (subseq host-port (+ close 2))))))))
      (t
       (let ((colon (position #\: host-port)))
         (and (tool-uri-host-p (subseq host-port 0 colon))
              (or (not colon)
                  (tool-uri-port-p (subseq host-port (1+ colon))))))))))

(defun project-tool-source-uri (value)
  (let ((uri (normalize-tool-string value)))
    (unless (and uri (tool-uri-input-valid-p uri))
      (return-from project-tool-source-uri nil))
    (let ((colon (position #\: uri)))
      (unless (and colon
                   (cl-ppcre:scan "\\A[A-Za-z][A-Za-z0-9+.-]*\\z" (subseq uri 0 colon)))
        (return-from project-tool-source-uri nil))
      (let* ((scheme (subseq uri 0 colon))
             (file-p (string-equal scheme "file"))
             (start (1+ colon))
             (end (or (position-if (lambda (character) (find character "?#")) uri :start start)
                      (length uri)))
             (authority "")
             (path ""))
        (cond
          ((and (<= (+ start 2) end) (string= uri "//" :start1 start :end1 (+ start 2)))
           (let ((path-start (or (position #\/ uri :start (+ start 2) :end end) end)))
             (setf authority (subseq uri (+ start 2) path-start)
                   path (subseq uri path-start end))))
          ((and file-p (< start end) (char= (char uri start) #\/))
           (setf path (subseq uri start end)))
          (t (return-from project-tool-source-uri nil)))
        (unless (and (tool-uri-authority-p authority file-p)
                     (or (not file-p)
                         (and (plusp (length path)) (char= (char path 0) #\/))))
          (return-from project-tool-source-uri nil))
        (concatenate 'string (if file-p "file" scheme) "://"
                     (subseq authority (let ((at (position #\@ authority)))
                                         (if at (1+ at) 0)))
                     path)))))

(defun tool-execution-attributes (kind skill-name description source-uri resource-name
                                 executable-name executable-path exit-code capture)
  (unless (tool-execution-kind-p kind)
    (return-from tool-execution-attributes nil))
  (let ((attributes nil))
    (flet ((add-string (key value)
             (let ((normalized (normalize-tool-string value)))
               (when normalized
                 (push (otel-string-attr key normalized) attributes)))))
      (add-string "gen_ai.skill.name" skill-name)
      (unless (eq kind :load-skill)
        (add-string "gen_ai.skill.resource.name" resource-name))
      (when (eq kind :command)
        (add-string "process.executable.name" executable-name)
        (when (typep exit-code '(signed-byte 64))
          (push (otel-int-attr "process.exit.code" exit-code) attributes)))
      (when (capture-keeps-span-content-p capture)
        (add-string "gen_ai.skill.description" description)
        (add-string "gen_ai.skill.source.uri" (project-tool-source-uri source-uri))
        (when (eq kind :command)
          (add-string "process.executable.path" executable-path))))
    (nreverse attributes)))
